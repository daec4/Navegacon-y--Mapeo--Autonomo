<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>agro_robot_interfaces</name>
  <version>0.1.0</version>
  <description>Interfaces personalizadas (msg, srv, action) para el robot agrícola agro_robot</description>
  <maintainer email="juancruz@espol.edu.ec">Juan Cruz</maintainer>
  <maintainer email="daescarr@espol.edu.ec">Daniel Espinoza</maintainer>
  <maintainer email="byalort@espol.edu.ec">Byron Ortega</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>action_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
