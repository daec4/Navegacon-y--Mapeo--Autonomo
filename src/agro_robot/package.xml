<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>agro_robot</name>
  <version>0.1.0</version>
  <description>Nodos y tópicos de un robot móvil para control de plagas en banano y cacao</description>
  <maintainer email="juancruz@espol.edu.ec">Juan Cruz</maintainer>
  <maintainer email="daescarr@espol.edu.ec">Daniel Espinoza</maintainer>
  <maintainer email="byalort@espol.edu.ec">Byron Ortega</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>agro_robot_interfaces</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
